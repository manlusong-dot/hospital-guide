<view class="page">
  <view class="segmented">
    <view class="segmented-item {{tab === 'medicine' ? 'active' : ''}}" bindtap="switchTab" data-tab="medicine">用药常识</view>
    <view class="segmented-item {{tab === 'exam' ? 'active' : ''}}" bindtap="switchTab" data-tab="exam">检查须知</view>
  </view>

  <block wx:if="{{tab === 'medicine'}}">
    <view class="card guide-card" wx:for="{{medicineList}}" wx:key="id">
      <view class="tag">{{item.category}}</view>
      <view class="title-2 guide-title">{{item.title}}</view>
      <view class="body guide-content">{{item.content}}</view>
    </view>
    <view class="card" wx:if="{{medicineList.length === 0}}">
      <view class="footnote">正在加载...</view>
    </view>
  </block>

  <block wx:if="{{tab === 'exam'}}">
    <view class="card guide-card" wx:for="{{examList}}" wx:key="id">
      <view class="row-between">
        <view class="title-2 flex-1">{{item.exam_name}}</view>
        <view class="tag tag-warn" wx:if="{{item.fasting}}">需空腹</view>
      </view>
      <view class="footnote exam-duration">用时约 {{item.duration}}</view>
      <view class="body guide-content">{{item.prep_text}}</view>
    </view>
    <view class="card" wx:if="{{examList.length === 0}}">
      <view class="footnote">正在加载...</view>
    </view>
  </block>
</view>
