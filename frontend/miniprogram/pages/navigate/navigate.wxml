<view class="page">
  <view class="card picker-card">
    <view class="picker-row">
      <view class="picker-label">从</view>
      <picker mode="selector" range="{{startNames}}" value="{{startIndex}}" bindchange="onStartChange">
        <view class="picker-value">
          <text>{{startNames[startIndex] || '主入口'}}</text>
          <view class="picker-chevron">›</view>
        </view>
      </picker>
    </view>
    <view class="picker-row">
      <view class="picker-label">到</view>
      <picker mode="selector" range="{{endNames}}" value="{{endIndex}}" bindchange="onEndChange">
        <view class="picker-value">
          <text>{{endNames[endIndex] || '请选择目的地'}}</text>
          <view class="picker-chevron">›</view>
        </view>
      </picker>
    </view>
    <view class="btn-primary" bindtap="startNavigate">{{loading ? '正在规划路线...' : '开始导航'}}</view>
  </view>

  <view class="card map-card">
    <view class="voice-row">
      <text class="voice-label">语音提示助手</text>
      <switch checked="{{voiceEnabled}}" bindchange="toggleVoice" color="#007AFF"/>
    </view>
    <view class="floor-tabs">
      <view class="floor-tab {{currentFloor === item ? 'active' : ''}} {{routeFloors[item] ? 'has-route' : ''}}"
            wx:for="{{floors}}" wx:key="*this" bindtap="switchFloor" data-floor="{{item}}">
        {{item}}F
      </view>
    </view>
    <canvas type="2d" id="mapCanvas" class="map-canvas" bindtap="onMapTap"></canvas>
    <view class="footnote map-hint">蓝线是路线，绿点是起点，红点是终点，橙点是换楼层的地方</view>
  </view>

  <view class="card" wx:if="{{route}}">
    <view class="title-2">路线指引</view>
    <view class="route-summary">
      <view class="route-distance">约 {{route.distance_m}} 米</view>
      <view class="footnote route-fromto">{{route.start.name}} → {{route.end.name}}</view>
    </view>
    <view class="step-line" wx:for="{{route.steps}}" wx:key="index">
      <view class="step-dot"></view>
      <view class="body flex-1">
        <text>{{item.text}}</text>
        <text class="step-notice" wx:if="{{item.notice}}">{{item.notice}}</text>
      </view>
    </view>
    <view class="btn-row">
      <view class="btn-secondary btn-row-item" bindtap="speakRoute">朗读路线</view>
      <view class="btn-secondary btn-row-item" bindtap="startNavigate">重新规划</view>
    </view>
    <view class="btn-row" wx:if="{{hasJourney}}">
      <view class="btn-primary btn-row-item" bindtap="goJourney">返回就诊流程</view>
    </view>
  </view>
</view>
