.form-card {
  padding: 12rpx 32rpx;
}

.section-title {
  padding-top: 20rpx;
  margin-bottom: 8rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EFEFF0;
}

.form-row:last-of-type {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #1C1C1E;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  color: #1C1C1E;
}

.picker-chevron {
  color: #C7C7CC;
  font-size: 40rpx;
  font-weight: 300;
}

.tip-demo {
  text-align: center;
  margin-bottom: 12rpx;
}

/* ---------- 医生列表 ---------- */
.doctor-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EFEFF0;
}

.doctor-row:last-child {
  border-bottom: none;
}

.doctor-row.selected {
  background: #E3F0FF;
  border-radius: 20rpx;
  padding: 24rpx;
  border-bottom: none;
}

.doctor-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.doctor-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #6D6D72;
  margin-left: 8rpx;
}

.doctor-intro {
  margin-top: 4rpx;
}

.empty-hint {
  text-align: center;
  padding: 32rpx 0;
}

/* ---------- 挂号成功 ---------- */
.result-card {
  text-align: center;
}

.result-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #34C759;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 96rpx;
  margin: 8rpx auto 16rpx;
}

.result-title {
  margin-bottom: 20rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EFEFF0;
  text-align: left;
}

.result-row:last-child {
  border-bottom: none;
}

/* ---------- 挂号记录 ---------- */
.record-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EFEFF0;
}

.record-row:last-child {
  border-bottom: none;
}

.record-action {
  color: #007AFF;
  font-size: 28rpx;
  margin-left: 18rpx;
  white-space: nowrap;
}

.record-disabled {
  margin-left: 18rpx;
  color: #8E8E93;
  white-space: nowrap;
}
